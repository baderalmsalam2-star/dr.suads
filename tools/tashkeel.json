 "واختلفوا فيما إذا تراخى القبول عن الإيجاب": "وَاخْتَلَفُوا فِيمَا إِذَا تَرَاخَى الْقَبُولُ عَنِ الْإِيجَابِ",
 "واستدل الجمهور على ذلك بما يأتي": "وَاسْتَدَلَّ الْجُمْهُورُ عَلَى ذَلِكَ بِمَا يَأْتِي",
 "واستدل القائلون بصحة وكالة الصبي المميز": "وَاسْتَدَلَّ الْقَائِلُونَ بِصِحَّةِ وَكَالَةِ الصَّبِيِّ الْمُمَيِّزِ",
 "واستدل لهذا القول بقول النبي صلى الله عليه وسلم": "وَاسْتُدِلَّ لِهَذَا الْقَوْلِ بِقَوْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
 "واستدلوا بقول النبي صلى الله عليه وسلم": "وَاسْتَدَلُّوا بِقَوْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
 "واستدلوا لصحة التوكيل بالخصومة": "وَاسْتَدَلُّوا لِصِحَّةِ التَّوْكِيلِ بِالْخُصُومَةِ",
 "والأصل في ذلك قوله تعالى": "وَالْأَصْلُ فِي ذَلِكَ قَوْلُهُ تَعَالَى",
 "وبناء على هذا الأصل قال الزركشي": "وَبِنَاءً عَلَى هَذَا الْأَصْلِ قَالَ الزَّرْكَشِيُّ",
 "وجه الدلالة": "وَجْهُ الدَّلَالَةِ",
 "وجه الدلالة من الأحاديث": "وَجْهُ الدَّلَالَةِ مِنَ الْأَحَادِيثِ",
 "ورقة عمل": "وَرَقَةُ عَمَلٍ",
 "وروي عن ابن مسعود والثوري والأوزاعي أنهم قالوا": "وَرُوِيَ عَنِ ابْنِ مَسْعُودٍ وَالثَّوْرِيِّ وَالْأَوْزَاعِيِّ أَنَّهُمْ قَالُوا",
 "وزاد الشافعية": "وَزَادَ الشَّافِعِيَّةُ",
 "وعرفها الحنابلة": "وَعَرَّفَهَا الْحَنَابِلَةُ",
 "وعرفها المالكية بأنها": "وَعَرَّفَهَا الْمَالِكِيَّةُ بِأَنَّهَا",
 "وعند الشافعية": "وَعِنْدَ الشَّافِعِيَّةِ",
 "وقالوا": "وَقَالُوا",
 "وقالوا في الأصح": "وَقَالُوا فِي الْأَصَحِّ",
 "وقت استحقاق الأجرة": "وَقْتُ اسْتِحْقَاقِ الْأُجْرَةِ",
 "وقت اعتبار الشروط والوصاية إلى اثنين": "وَقْتُ اعْتِبَارِ الشُّرُوطِ، وَالْوِصَايَةُ إِلَى اثْنَيْنِ",
 "وقوله (وتنفيذها)": "وَقَوْلُهُ (وَتَنْفِيذُهَا)",
 "وقوله صلى الله عليه وسلم": "وَقَوْلُهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ",
 "وقوله عليه الصلاة والسلام": "وَقَوْلُهُ عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ",
 "ولأن الله عز وجل أخبر عن أهل الكهف أنهم قالوا": "وَلِأَنَّ اللهَ عَزَّ وَجَلَّ أَخْبَرَ عَنْ أَهْلِ الْكَهْفِ أَنَّهُمْ قَالُوا",
 "ولاية المرأة في تزويج نفسها": "وِلَايَةُ الْمَرْأَةِ فِي تَزْوِيجِ نَفْسِهَا",
 "ولاية ناظر الوقف": "وِلَايَةُ نَاظِرِ الْوَقْفِ",
 "وللأب في أي وقت أن يعدل عن اختياره وصيا لصغيره": "وَلِلْأَبِ فِي أَيِّ وَقْتٍ أَنْ يَعْدِلَ عَنِ اخْتِيَارِهِ وَصِيًّا لِصَغِيرِهِ",
 "ومثال التأقيت": "وَمِثَالُ التَّأْقِيتِ",
 "وهذه الولاية على الوقف تنقسم عند الفقهاء إلى قسمين": "وَهَذِهِ الْوِلَايَةُ عَلَى الْوَقْفِ تَنْقَسِمُ عِنْدَ الْفُقَهَاءِ إِلَى قِسْمَيْنِ",
 "ووجه الدلالة: من الآيات واضح في اشتراط": "وَوَجْهُ الدَّلَالَةِ: مِنَ الْآيَاتِ وَاضِحٌ فِي اشْتِرَاطِ",
 "وولاية على النفس": "وَوِلَايَةٌ عَلَى النَّفْسِ",
 "ويرى الحنابلة": "وَيَرَى الْحَنَابِلَةُ"
}